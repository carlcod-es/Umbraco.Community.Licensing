{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedTelemetryLevel": "Minimal",
        // Public, demo-only login for the local demo site. Never use it in a real site.
        "UnattendedUserName": "Demo Administrator",
        "UnattendedUserEmail": "demo@acme.example",
        "UnattendedUserPassword": "Acme-Demo-Only-1"
      },
      "Hosting": {
        "Debug": true
      }
    }
  }
}
