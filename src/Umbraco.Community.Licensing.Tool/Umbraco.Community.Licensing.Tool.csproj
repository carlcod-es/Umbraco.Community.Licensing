<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Version.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Umbraco.Community.Licensing.Tool</RootNamespace>
    <AssemblyName>Umbraco.Community.Licensing.Tool</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ucl</ToolCommandName>
    <PackageId>Umbraco.Community.Licensing.Tool</PackageId>
    <Description>Console tool for Umbraco package vendors: manage products, customers and license keys, and issue offline licenses with Umbraco.Community.Licensing.</Description>
    <Authors>Carl Sargunar</Authors>
    <RepositoryUrl>https://github.com/carlcod-es/Umbraco.Community.Licensing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>licensing;license-key;umbraco;vendor;tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\docs\vendor-tool.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.Licensing.Tool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="[10.0.14]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.14]">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbraco.Community.Licensing\Umbraco.Community.Licensing.csproj" />
  </ItemGroup>

</Project>
