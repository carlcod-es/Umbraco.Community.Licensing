# Generated sources keep LF on every OS, matching the generator output (tighten-text-rule design.md "Line endings").
*.g.cs text eol=lf
# The sample backoffice client keeps LF on every OS, so regenerating src/api on Windows does not churn it.
samples/Acme.ContactForm/Client/** text eol=lf
# The demo site's seeded template views keep LF on every OS, so Umbraco's rewrite does not churn them.
samples/Acme.ContactForm.Site/Views/home.cshtml text eol=lf
samples/Acme.ContactForm.Site/Views/contact.cshtml text eol=lf
